# Kling API credential (2.0): a static API Key from https://kling.ai/dev/api-key
KLING_API_KEY=

# 1.x AccessKey/SecretKey (JWT) — still read by the 1.x CLI until the 2.0 removal commit;
# the current Kling API rejects them on new-standard endpoints (401 / 1002).
KLING_ACCESS_KEY=your-access-key-here
KLING_SECRET_KEY=your-secret-key-here
