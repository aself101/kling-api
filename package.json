{
  "name": "kling-api",
  "version": "2.0.0",
  "description": "Kling AI API wrapper for Node.js \u2014 video (new API standard), image, elements, voices, avatar and TTS with a static API Key",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "kling": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "check:cycles": "madge --circular --extensions ts src",
    "kling": "node dist/cli/index.js",
    "verify": "npm run lint && npm run check:cycles && npm run build && npm test && npx tsc --noEmit && test -f dist/index.js && test -f dist/cli/index.js"
  },
  "keywords": [
    "kling",
    "kling-ai",
    "klingai",
    "video-generation",
    "image-generation",
    "text-to-video",
    "image-to-video",
    "avatar",
    "ai-video",
    "ai-image",
    "typescript",
    "text-to-speech",
    "motion-control"
  ],
  "author": "img-gen Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aself101/kling-api.git"
  },
  "bugs": {
    "url": "https://github.com/aself101/kling-api/issues"
  },
  "homepage": "https://github.com/aself101/kling-api#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@types/node": ">=20",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.10",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "undici": "^7.29.1",
    "vitest": "^4.0.10"
  }
}
