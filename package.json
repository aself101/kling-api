{
  "name": "kling-api",
  "version": "1.0.0",
  "description": "Kling AI API wrapper - Video and image generation with JWT authentication for Node.js",
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "type": "module",
  "bin": {
    "kling": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./api": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./auth": {
      "import": "./dist/auth.js",
      "types": "./dist/auth.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "kling": "node dist/cli.js",
    "kling:help": "node dist/cli.js --help",
    "kling:examples": "node dist/cli.js --examples",
    "kling:video:help": "node dist/cli.js video --help",
    "kling:video:examples": "node dist/cli.js video examples",
    "check:cycles": "madge --circular --extensions ts src"
  },
  "keywords": [
    "kling",
    "kling-ai",
    "klingai",
    "video-generation",
    "image-generation",
    "text-to-video",
    "image-to-video",
    "avatar",
    "ai-video",
    "ai-image",
    "typescript",
    "jwt"
  ],
  "author": "img-gen Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aself101/kling-api.git"
  },
  "bugs": {
    "url": "https://github.com/aself101/kling-api/issues"
  },
  "homepage": "https://github.com/aself101/kling-api#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.10",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "madge": "^8.0.0",
    "nock": "^14.0.10",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "undici": "^7.29.1",
    "vitest": "^4.0.10"
  }
}
